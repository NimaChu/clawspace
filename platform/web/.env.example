# 站点基础地址
SITE_URL=http://127.0.0.1:4321

# 公网部署必须把不受信任的用户应用放到独立 origin，并将该域名路由到同一服务。
# 例如主站 https://example.com，应用站 https://apps.example.com。
HOSTED_APPS_ORIGIN=
# 仅限可信的本机演示；公网不要开启。
ALLOW_UNSAFE_SAME_ORIGIN_APPS=false

# 明确指定初始管理员邮箱，避免公网空数据库被首位注册者接管。
ADMIN_EMAIL=

# 留空时根据 NODE_ENV/SITE_URL 自动启用；公网 HTTPS 可显式设为 true。
COOKIE_SECURE=

# GitHub OAuth
# 本地回调地址示例:
# http://127.0.0.1:4321/api/auth/github/callback
# 公网回调地址示例:
# https://your-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 阿里云百炼（北京区）
# 兼容模式接口:
# https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.5-plus
DASHSCOPE_TEXT_MODEL=qwen3.5-plus
DASHSCOPE_MULTIMODAL_MODEL=qwen3-vl-plus-2025-12-19
DASHSCOPE_CODE_MODEL=qwen3-coder-next

# 运行时数据库
# 配置后，runtime/data/* 会优先写入数据库
# 如果要完全切回本地文件存储，请留空 DATABASE_URL
DATABASE_URL=
# 如数据库不需要 SSL，可显式关闭:
# DATABASE_SSL_MODE=disable

# 对象存储
# 在 Vercel 上可直接使用 Blob；完全切回本地文件时，推荐设为 filesystem
# OBJECT_STORAGE_PROVIDER=filesystem
# OBJECT_STORAGE_PROVIDER=vercel-blob
BLOB_READ_WRITE_TOKEN=

# 上传限流白名单（可选）
# 用英文逗号分隔。命中后将跳过 /api/import-app 的上传频率限制。
# IMPORT_RATE_LIMIT_BYPASS_IPS=1.2.3.4,5.6.7.8
# IMPORT_RATE_LIMIT_BYPASS_EMAILS=you@example.com,another@example.com

# 登录 / 注册限流白名单（可选）
# 用英文逗号分隔。命中后将跳过 /api/auth/login 和 /api/auth/register 的频率限制。
# AUTH_RATE_LIMIT_BYPASS_IPS=1.2.3.4,5.6.7.8
# AUTH_RATE_LIMIT_BYPASS_EMAILS=you@example.com,another@example.com
