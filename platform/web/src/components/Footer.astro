---
// src/components/Footer.astro
import { getTranslationsForLocale } from '../lib/i18n.js';
const locale = Astro.props.locale;
const t = getTranslationsForLocale(locale);
---

<footer class="border-t border-white/10 bg-[#050816] text-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
      <div class="max-w-xl">
        <h3 class="bg-gradient-to-r from-cyan-300 via-sky-400 to-fuchsia-300 bg-clip-text text-2xl font-bold text-transparent">
          Nima Tech Space
        </h3>
        <p class="mt-3 text-sm leading-7 text-slate-400">
          {t.footerDescription}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 text-sm text-slate-300">
        <a
          href="https://github.com/NimaChu"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-4 py-2 transition-colors hover:bg-white/10"
        >
          GitHub
        </a>
        <a
          href="mailto:783838914@qq.com"
          class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-4 py-2 transition-colors hover:bg-white/10"
        >
          {t.footerContact}
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 py-5 text-sm text-slate-500 md:flex md:items-center md:justify-between">
      <p>&copy; 2026 NimaTech</p>
      <p class="mt-2 md:mt-0">{t.footerPowered}</p>
    </div>
  </div>
</footer>
