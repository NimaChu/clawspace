---
interface PostItem {
  data: {
    title: string;
    date: string;
    description?: string;
  };
  slug: string;
}
const { posts } = Astro.props as { posts: PostItem[] };
---

{posts.length > 0 ? (
  <div class="space-y-8">
    {posts.map(post => (
      <article
        class="border-b border-gray-200 dark:border-gray-700 pb-6 last:border-0"
        aria-labelledby={`post-title-${post.slug}`}
      >
        <time
          class="text-sm text-gray-500 dark:text-gray-400"
          datetime={new Date(post.data.date).toISOString()}
        >
          {new Date(post.data.date).toLocaleDateString('zh-CN')}
        </time>
        <h2 class="text-2xl font-bold mt-2 mb-3" id={`post-title-${post.slug}`}>
          <a
            href={`/posts/${post.slug}/`}
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors hover:underline"
          >
            {post.data.title}
          </a>
        </h2>
        {post.data.description && (
          <p class="text-gray-600 dark:text-gray-300">{post.data.description}</p>
        )}
      </article>
    ))}
  </div>
) : (
  <div class="text-center py-12">
    <p class="text-gray-500 dark:text-gray-400">暂无文章</p>
  </div>
)}