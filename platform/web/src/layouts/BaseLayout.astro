---
interface Props {
  title?: string;
}
const { title } = Astro.props;

// Theme toggle function
const toggleTheme = () => {
  const html = document.documentElement;
  const currentTheme = localStorage.getItem('theme');

  if (currentTheme === 'dark') {
    html.classList.remove('dark');
    localStorage.setItem('theme', 'light');
  } else {
    html.classList.add('dark');
    localStorage.setItem('theme', 'dark');
  }
};
---

<!DOCTYPE html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Nima 的技术博客 - 分享攻略、教程和有用信息" />
    <title>{title ? `${title} | Nima's Tech Blog` : "Nima's Tech Blog"}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <script>
      // Dark mode initialization
      if (localStorage.getItem('theme') === 'dark' ||
          (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100 transition-colors duration-200 min-h-screen flex flex-col">
    <header class="max-w-4xl mx-auto px-4 py-6 border-b border-gray-200 dark:border-gray-700 w-full">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl md:text-3xl font-bold">
            <a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Nima's Tech Blog
            </a>
          </h1>
          <p class="text-gray-600 dark:text-gray-400 mt-1 text-sm md:text-base">
            分享技术攻略、旅行指南和各种有用信息
          </p>
        </div>
        <button
          id="theme-toggle"
          class="px-3 py-2 rounded-lg bg-gray-200 dark:bg-gray-700 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors"
          aria-label="切换主题"
          onclick={toggleTheme.toString()}
        >
          <span class="dark:hidden">🌙</span>
          <span class="hidden dark:inline">☀️</span>
        </button>
      </div>
    </header>
    <main class="flex-grow">
      <slot />
    </main>
    <footer class="max-w-4xl mx-auto px-4 py-8 text-center text-gray-500 dark:text-gray-400 text-sm w-full mt-auto">
      <div class="flex flex-col items-center gap-2">
        <p>© {new Date().getFullYear()} Nima's Tech Blog</p>
        <p class="text-xs">Powered by Astro + Tailwind CSS</p>
      </div>
    </footer>
  </body>
</html>