---
import Layout from '../components/Layout.astro';
import { getCurrentUser } from '../lib/auth.js';

const currentUser = await getCurrentUser(Astro.request);

if (!currentUser) {
  return Astro.redirect('/login?next=%2Faccount');
}

const success = Astro.url.searchParams.get('success');
const error = Astro.url.searchParams.get('error');
const githubBindUrl = `/api/auth/github/start?mode=link&next=${encodeURIComponent('/account')}`;
---

<Layout title="账号设置" description="管理你的账号信息与 GitHub 绑定。">
  <section class="min-h-screen bg-[#0a0a0a] py-16 lg:py-24">
    <div class="container mx-auto max-w-4xl px-4">
      <div class="rounded-3xl border border-white/10 bg-[#141414] p-8">
        <p class="text-sm uppercase tracking-[0.18em] text-cyan-300">Account</p>
        <h1 class="mt-4 text-4xl font-bold text-white">账号设置</h1>
        <p class="mt-4 text-gray-400">这里可以查看当前账号信息，并决定是否绑定 GitHub。</p>

        {success && (
          <div class="mt-6 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-200">
            {success}
          </div>
        )}

        {error && (
          <div class="mt-6 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
            {error}
          </div>
        )}

        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <p class="text-sm uppercase tracking-[0.18em] text-gray-500">基本资料</p>
            <form id="profile-form" class="mt-5 space-y-4 text-sm text-gray-300">
              <input type="hidden" name="action" value="profile" />
              <div>
                <label class="mb-2 block text-gray-500" for="displayName">显示名称</label>
                <input
                  id="displayName"
                  name="displayName"
                  type="text"
                  value={currentUser.displayName}
                  class="w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none transition focus:border-cyan-400"
                />
              </div>
              <div>
                <label class="mb-2 block text-gray-500" for="email">邮箱</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  value={currentUser.email}
                  class="w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none transition focus:border-cyan-400"
                />
              </div>
              <div class="space-y-2 text-xs text-gray-500">
                <p>登录方式：{currentUser.provider || 'password'}</p>
                <p>密码登录：{currentUser.hasPassword ? '已开启' : '未设置'}</p>
              </div>
              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-2xl border border-cyan-400/30 bg-cyan-400/10 px-5 py-3 font-semibold text-cyan-100 transition hover:bg-cyan-400/20"
              >
                保存资料
              </button>
            </form>
          </div>

          <div class="rounded-3xl border border-white/10 bg-white/5 p-6">
            <p class="text-sm uppercase tracking-[0.18em] text-gray-500">GitHub 绑定</p>
            {currentUser.githubConnected ? (
              <>
                <p class="mt-5 text-lg font-semibold text-white">已绑定 GitHub</p>
                <p class="mt-3 text-sm text-gray-400">这个账号已经和 GitHub 建立连接，之后可以直接使用 GitHub 登录。</p>
                {currentUser.avatarUrl && (
                  <img src={currentUser.avatarUrl} alt={currentUser.displayName} class="mt-5 h-14 w-14 rounded-full border border-white/10" />
                )}
              </>
            ) : (
              <>
                <p class="mt-5 text-lg font-semibold text-white">尚未绑定 GitHub</p>
                <p class="mt-3 text-sm text-gray-400">绑定后，你可以继续保留邮箱密码登录，同时也能直接用 GitHub 快速登录。</p>
                <a
                  href={githubBindUrl}
                  class="mt-6 inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white transition-colors hover:bg-white/10"
                >
                  绑定 GitHub 账号
                </a>
              </>
            )}
          </div>
        </div>

        <div class="mt-6 rounded-3xl border border-white/10 bg-white/5 p-6">
          <p class="text-sm uppercase tracking-[0.18em] text-gray-500">密码设置</p>
          <form id="password-form" class="mt-5 grid gap-4 lg:grid-cols-3">
            <input type="hidden" name="action" value="password" />
            <div>
              <label class="mb-2 block text-sm text-gray-500" for="currentPassword">当前密码</label>
              <input
                id="currentPassword"
                name="currentPassword"
                type="password"
                placeholder={currentUser.hasPassword ? '输入当前密码' : '当前无需填写'}
                class="w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none transition focus:border-cyan-400"
              />
            </div>
            <div>
              <label class="mb-2 block text-sm text-gray-500" for="nextPassword">新密码</label>
              <input
                id="nextPassword"
                name="nextPassword"
                type="password"
                placeholder="至少 8 位"
                class="w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none transition focus:border-cyan-400"
              />
            </div>
            <div>
              <label class="mb-2 block text-sm text-gray-500" for="confirmPassword">确认新密码</label>
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                placeholder="再次输入新密码"
                class="w-full rounded-2xl border border-white/10 bg-black/20 px-4 py-3 text-white outline-none transition focus:border-cyan-400"
              />
            </div>
            <div class="lg:col-span-3">
              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-2xl border border-white/10 bg-white/5 px-5 py-3 font-semibold text-white transition hover:bg-white/10"
              >
                更新密码
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <script>
    async function submitAccountForm(form, onSuccess) {
      const response = await fetch('/api/auth/account', {
        method: 'POST',
        body: new FormData(form)
      });

      const payload = await response.json();
      if (!response.ok) {
        throw new Error(payload.error || '保存失败');
      }

      onSuccess?.(payload);
      window.location.href = `/account?success=${encodeURIComponent(payload.message || '保存成功')}`;
    }

    const profileForm = document.getElementById('profile-form');
    const passwordForm = document.getElementById('password-form');

    profileForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await submitAccountForm(profileForm);
      } catch (error) {
        window.location.href = `/account?error=${encodeURIComponent(error instanceof Error ? error.message : '保存失败')}`;
      }
    });

    passwordForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await submitAccountForm(passwordForm, () => {
          passwordForm.reset();
        });
      } catch (error) {
        window.location.href = `/account?error=${encodeURIComponent(error instanceof Error ? error.message : '密码更新失败')}`;
      }
    });
  </script>
</Layout>
