---
import '../../lib/env.js';
import Layout from '../../components/Layout.astro';
import { getCurrentUser, isAdmin } from '../../lib/auth.js';
import { readSiteConfig } from '../../lib/site-config.js';

const currentUser = await getCurrentUser(Astro.request);

if (!currentUser) {
  return Astro.redirect('/login?next=%2Fadmin%2Fmodel');
}
const isCurrentUserAdmin = isAdmin(currentUser);

const siteConfig = await readSiteConfig();
const llmConfig = siteConfig.llm;
const hasDashScopeKey = Boolean(process.env.DASHSCOPE_API_KEY);
---

{!isCurrentUserAdmin ? (
  <Layout title="无权限" description="当前账号没有访问模型配置的权限。">
    <section class="min-h-screen bg-[#0a0a0a] text-white grid place-items-center">
      <div class="text-center">
        <h1 class="text-4xl font-bold mb-4">无权限访问</h1>
        <p class="text-gray-400 mb-6">模型配置仅对管理员开放。</p>
        <a href="/" class="inline-flex items-center justify-center rounded-xl bg-cyan-500 px-6 py-3 font-semibold text-slate-950 hover:bg-cyan-400">
          返回首页
        </a>
      </div>
    </section>
  </Layout>
) : (
<Layout title="站点模型配置" description="配置站点统一模型服务与基础限流规则。">
  <section class="min-h-screen bg-[#0a0a0a] py-16 lg:py-24">
    <div class="container mx-auto max-w-5xl px-4">
      <div class="mb-12">
        <p class="inline-flex items-center rounded-full border border-cyan-500/20 bg-cyan-500/10 px-4 py-1.5 text-sm font-medium text-cyan-300">
          Bailian Model
        </p>
        <h1 class="mt-6 text-4xl font-bold text-white md:text-5xl">站点模型配置</h1>
        <p class="mt-4 max-w-3xl text-lg text-gray-400">
          这里管理所有导入应用共用的模型入口，包括默认模型、开关状态和基础限流。
        </p>
        <p class="mt-3 text-sm text-gray-500">当前上游：阿里云百炼北京区 OpenAI 兼容接口。</p>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="rounded-3xl border border-white/10 bg-[#141414] p-8">
          <form id="site-model-form" class="space-y-6">
            <label class="flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 px-5 py-4">
              <div>
                <p class="font-semibold text-white">启用站点模型</p>
                <p class="mt-1 text-sm text-gray-400">关闭后所有应用都无法调用统一模型接口。</p>
              </div>
              <input id="llm-enabled" type="checkbox" class="h-5 w-5 accent-cyan-400" checked={llmConfig.enabled !== false} />
            </label>

            <label class="block">
              <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">文本模型</span>
              <input
                id="llm-text-model"
                type="text"
                value={llmConfig.models.text}
                class="block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition-colors focus:border-cyan-400/40"
                placeholder="qwen3.5-plus"
              />
            </label>

            <label class="block">
              <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">多模态模型</span>
              <input
                id="llm-multimodal-model"
                type="text"
                value={llmConfig.models.multimodal}
                class="block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition-colors focus:border-cyan-400/40"
                placeholder="qwen3-vl-plus-2025-12-19"
              />
            </label>

            <label class="block">
              <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">Code 模型</span>
              <input
                id="llm-code-model"
                type="text"
                value={llmConfig.models.code}
                class="block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition-colors focus:border-cyan-400/40"
                placeholder="qwen3-coder-next"
              />
              <p class="mt-2 text-sm text-gray-500">推荐文本先用 `qwen3.5-plus`，多模态用 `qwen3-vl-plus-2025-12-19`，代码用 `qwen3-coder-next`。</p>
            </label>

            <div class="grid gap-5 md:grid-cols-2">
              <label class="block">
                <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">每 IP 每分钟</span>
                <input
                  id="llm-per-minute"
                  type="number"
                  min="1"
                  value={llmConfig.perIpPerMinute}
                  class="block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition-colors focus:border-cyan-400/40"
                />
              </label>

              <label class="block">
                <span class="mb-3 block text-sm font-semibold uppercase tracking-[0.18em] text-gray-400">每 IP 每天</span>
                <input
                  id="llm-per-day"
                  type="number"
                  min="1"
                  value={llmConfig.perIpPerDay}
                  class="block w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white outline-none transition-colors focus:border-cyan-400/40"
                />
              </label>
            </div>

            <div class="flex flex-wrap gap-3">
              <button
                type="submit"
                class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-cyan-400 to-blue-500 px-6 py-3 text-base font-semibold text-black transition-transform duration-300 hover:scale-[1.01]"
              >
                保存站点模型配置
              </button>
              <button
                id="llm-check-button"
                type="button"
                class="inline-flex items-center justify-center rounded-2xl border border-white/15 bg-white/5 px-6 py-3 text-base font-semibold text-white transition-colors hover:border-cyan-400/40 hover:bg-cyan-500/10"
              >
                检测当前模型是否可用
              </button>
            </div>
          </form>

          <div id="model-status" class="mt-6 hidden rounded-2xl border px-5 py-4 text-sm"></div>
          <div id="model-check-status" class="mt-6 hidden rounded-2xl border px-5 py-4 text-sm"></div>
        </div>

        <div class="space-y-6">
          <div class="rounded-3xl border border-white/10 bg-[#101010] p-8">
            <h2 class="text-2xl font-semibold text-white">当前状态</h2>
            <div class="mt-6 grid gap-4">
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-xs uppercase tracking-[0.18em] text-gray-500">百炼 API Key</p>
                <p class="mt-2 text-lg font-semibold text-white">{hasDashScopeKey ? '已配置' : '未配置'}</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-xs uppercase tracking-[0.18em] text-gray-500">文本模型</p>
                <p class="mt-2 text-lg font-semibold text-white">{llmConfig.models.text}</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-xs uppercase tracking-[0.18em] text-gray-500">多模态模型</p>
                <p class="mt-2 text-lg font-semibold text-white">{llmConfig.models.multimodal}</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-xs uppercase tracking-[0.18em] text-gray-500">Code 模型</p>
                <p class="mt-2 text-lg font-semibold text-white">{llmConfig.models.code}</p>
              </div>
              <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
                <p class="text-xs uppercase tracking-[0.18em] text-gray-500">当前限流</p>
                <p class="mt-2 text-lg font-semibold text-white">{llmConfig.perIpPerMinute} 次/分钟</p>
                <p class="text-sm text-gray-400">{llmConfig.perIpPerDay} 次/天</p>
              </div>
            </div>
          </div>

          <div class="rounded-3xl border border-white/10 bg-[#101010] p-8 text-sm text-gray-300">
            <h2 class="text-xl font-semibold text-white">使用建议</h2>
            <ul class="mt-5 space-y-3">
              <li>MVP 阶段推荐保守限流，先控制在 `6 次/分钟` 和 `60 次/天`。</li>
              <li>百炼北京区建议优先走兼容模式接口，后续更换模型时无需改应用前端。</li>
              <li>以后如果切到付费模型，只需要在这里改默认模型，不需要逐个应用修改。</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('site-model-form');
    const statusBox = document.getElementById('model-status');
    const checkStatusBox = document.getElementById('model-check-status');
    const checkButton = document.getElementById('llm-check-button');

    function showStatus(type, message) {
      statusBox.className = 'mt-6 rounded-2xl border px-5 py-4 text-sm';
      statusBox.classList.remove('hidden');

      if (type === 'success') {
        statusBox.classList.add('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-200');
      } else {
        statusBox.classList.add('border-rose-500/30', 'bg-rose-500/10', 'text-rose-200');
      }

      statusBox.textContent = message;
    }

    function renderCheckResult(result) {
      checkStatusBox.className = 'mt-6 rounded-2xl border px-5 py-4 text-sm';
      checkStatusBox.classList.remove('hidden');
      checkStatusBox.classList.add(
        result?.ok ? 'border-emerald-500/30' : 'border-amber-500/30',
        result?.ok ? 'bg-emerald-500/10' : 'bg-amber-500/10',
        result?.ok ? 'text-emerald-100' : 'text-amber-100'
      );

      const modelItems = result?.models || {};
      const rows = Object.values(modelItems).map((item) => {
        const badge = item?.ok ? '可用' : '不可用';
        const tone = item?.ok ? 'text-emerald-300' : 'text-amber-300';
        const latency = typeof item?.latencyMs === 'number' ? `${item.latencyMs}ms` : '--';
        const message = item?.message || '未返回结果';
        const modelName = item?.model || '未配置';

        return `
          <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-white">${item?.label || '模型'}</p>
                <p class="mt-1 text-xs text-gray-400">${modelName}</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-semibold ${tone}">${badge}</p>
                <p class="mt-1 text-xs text-gray-400">${latency}</p>
              </div>
            </div>
            <p class="mt-3 text-sm text-gray-200">${message}</p>
          </div>
        `;
      }).join('');

      const summary = result?.ok
        ? '当前配置里的文本、多模态和 Code 模型都可正常调用。'
        : (result?.error || '至少有一个模型当前不可用，请根据下方结果调整。');

      checkStatusBox.innerHTML = `
        <div class="space-y-4">
          <div>
            <p class="font-semibold text-white">可用性检测结果</p>
            <p class="mt-1 text-sm text-gray-200">${summary}</p>
          </div>
          <div class="grid gap-3">${rows}</div>
        </div>
      `;
    }

    function getFormPayload() {
      return {
        enabled: document.getElementById('llm-enabled')?.checked,
        textModel: document.getElementById('llm-text-model')?.value,
        multimodalModel: document.getElementById('llm-multimodal-model')?.value,
        codeModel: document.getElementById('llm-code-model')?.value,
        perIpPerMinute: document.getElementById('llm-per-minute')?.value,
        perIpPerDay: document.getElementById('llm-per-day')?.value,
      };
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const payload = getFormPayload();

      try {
        const response = await fetch('/api/admin/site-model', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();
        if (!response.ok || !result.success) {
          throw new Error(result.error || '保存失败');
        }

        showStatus('success', '站点模型配置已保存。');
        window.setTimeout(() => {
          window.location.reload();
        }, 700);
      } catch (error) {
        showStatus('error', error instanceof Error ? error.message : '保存失败');
      }
    });

    checkButton?.addEventListener('click', async () => {
      checkButton.setAttribute('disabled', 'disabled');
      checkButton.classList.add('opacity-60', 'cursor-not-allowed');
      checkButton.textContent = '检测中...';

      checkStatusBox.className = 'mt-6 rounded-2xl border border-cyan-500/30 bg-cyan-500/10 px-5 py-4 text-sm text-cyan-100';
      checkStatusBox.classList.remove('hidden');
      checkStatusBox.textContent = '正在检测当前表单里的模型配置，请稍候...';

      try {
        const response = await fetch('/api/admin/site-model-check', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(getFormPayload()),
        });

        const result = await response.json();
        if (!response.ok) {
          throw new Error(result.error || '模型检测失败');
        }

        renderCheckResult(result.result);
      } catch (error) {
        checkStatusBox.className = 'mt-6 rounded-2xl border border-rose-500/30 bg-rose-500/10 px-5 py-4 text-sm text-rose-200';
        checkStatusBox.classList.remove('hidden');
        checkStatusBox.textContent = error instanceof Error ? error.message : '模型检测失败';
      } finally {
        checkButton.removeAttribute('disabled');
        checkButton.classList.remove('opacity-60', 'cursor-not-allowed');
        checkButton.textContent = '检测当前模型是否可用';
      }
    });
  </script>
</Layout>
)}
