---
import Layout from '../../components/Layout.astro';
import { getCurrentUser, getUsers, isAdmin } from '../../lib/auth.js';
import { getCreatorPath, getCreatorSlugForUser } from '../../lib/creator-universe.js';

const currentUser = await getCurrentUser(Astro.request);

if (!currentUser) {
  return Astro.redirect('/login?next=%2Fadmin%2Fusers');
}

const isCurrentUserAdmin = isAdmin(currentUser);
const users = isCurrentUserAdmin
  ? await Promise.all(
      (await getUsers()).map(async (user) => {
        const creatorSlug = await getCreatorSlugForUser(user);
        return {
          ...user,
          creatorSlug,
          creatorPath: getCreatorPath(creatorSlug),
        };
      })
    )
  : [];
---

{!isCurrentUserAdmin ? (
  <Layout title="无权限" description="当前账号没有访问用户管理的权限。">
    <section class="min-h-screen bg-[#0a0a0a] text-white grid place-items-center">
      <div class="text-center">
        <h1 class="text-4xl font-bold mb-4">无权限访问</h1>
        <p class="text-gray-400 mb-6">用户管理仅对管理员开放。</p>
        <a href="/" class="inline-flex items-center justify-center rounded-xl bg-cyan-500 px-6 py-3 font-semibold text-slate-950 hover:bg-cyan-400">
          返回首页
        </a>
      </div>
    </section>
  </Layout>
) : (
  <Layout title="用户管理" description="管理后台用户与角色权限。">
    <section class="min-h-screen bg-[#0a0a0a] py-16 lg:py-24">
      <div class="container mx-auto max-w-6xl px-4">
        <div class="mb-12">
          <p class="inline-flex items-center rounded-full border border-cyan-500/20 bg-cyan-500/10 px-4 py-1.5 text-sm font-medium text-cyan-300">
            User Roles
          </p>
          <h1 class="mt-6 text-4xl font-bold text-white md:text-5xl">用户与权限</h1>
          <p class="mt-4 max-w-3xl text-lg text-gray-400">
            这里可以查看后台用户，并调整他们的角色。当前支持 `admin`、`editor` 和 `member` 三种角色。
          </p>
        </div>

        <div class="rounded-3xl border border-white/10 bg-[#101010] p-8">
          <div class="mb-8 rounded-2xl border border-white/10 bg-white/5 p-6">
            <h2 class="text-2xl font-semibold text-white">创建后台账号</h2>
            <p class="mt-2 text-sm text-gray-400">轻量创建一个新账号，并直接指定角色。</p>

            <form id="create-user-form" class="mt-6 grid gap-4 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm text-gray-400">显示名称</span>
                <input
                  name="displayName"
                  type="text"
                  class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white"
                  placeholder="例如 Orbit Editor"
                />
              </label>

              <label class="block">
                <span class="mb-2 block text-sm text-gray-400">邮箱</span>
                <input
                  name="email"
                  type="email"
                  required
                  class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white"
                  placeholder="name@example.com"
                />
              </label>

              <label class="block">
                <span class="mb-2 block text-sm text-gray-400">初始密码</span>
                <input
                  name="password"
                  type="text"
                  required
                  class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white"
                  placeholder="至少 8 位"
                />
              </label>

              <label class="block">
                <span class="mb-2 block text-sm text-gray-400">角色</span>
                <select
                  name="role"
                  class="w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white"
                >
                  <option value="member">member</option>
                  <option value="editor">editor</option>
                  <option value="admin">admin</option>
                </select>
              </label>

              <div class="md:col-span-2">
                <button
                  type="submit"
                  class="rounded-2xl bg-cyan-400 px-5 py-3 text-sm font-semibold text-black"
                >
                  创建账号
                </button>
              </div>
            </form>
          </div>

          <div class="mb-6 flex items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-semibold text-white">账号列表</h2>
              <p class="mt-2 text-sm text-gray-400">管理员可修改其他账号角色或删除账号，系统至少会保留一个管理员。</p>
            </div>
          </div>

          <div id="user-status" class="mb-6 hidden rounded-2xl border px-5 py-4 text-sm"></div>

          <div class="space-y-4" id="user-list">
            {users.map((user) => (
              <article class="rounded-2xl border border-white/10 bg-white/5 p-5" data-user-id={user.id}>
                <div class="grid gap-4 lg:grid-cols-[1.2fr_1fr_auto] lg:items-center">
                  <div>
                    <h3 class="text-lg font-semibold text-white">{user.displayName}</h3>
                    <p class="mt-2 text-sm text-gray-400">{user.email}</p>
                    <p class="mt-3 text-xs uppercase tracking-[0.18em] text-gray-500">
                      {user.provider} · {user.createdAt}
                    </p>
                    <p class="mt-2 text-xs text-gray-500">
                      最近登录：{user.lastLoginAt ? user.lastLoginAt : '暂未登录'}
                    </p>
                  </div>

                  <div class="rounded-2xl border border-white/10 bg-black/20 px-4 py-3">
                    <p class="text-xs uppercase tracking-[0.18em] text-gray-500">当前角色</p>
                    <p class="mt-2 text-lg font-semibold text-white">{user.role || 'member'}</p>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="flex items-center gap-3">
                      <a
                        href={user.creatorPath}
                        target="_blank"
                        rel="noreferrer"
                        class="rounded-2xl border border-white/10 px-4 py-3 text-sm font-medium text-white hover:bg-white/10"
                      >
                        查看主页
                      </a>
                      <select
                        class="rounded-2xl border border-white/10 bg-white/5 px-4 py-3 text-white"
                        data-role-select={user.id}
                      >
                        <option value="admin" selected={(user.role || 'member') === 'admin'}>admin</option>
                        <option value="editor" selected={(user.role || 'member') === 'editor'}>editor</option>
                        <option value="member" selected={(user.role || 'member') === 'member'}>member</option>
                      </select>
                      <button
                        type="button"
                        class="rounded-2xl bg-cyan-400 px-5 py-3 text-sm font-semibold text-black"
                        data-save-role={user.id}
                      >
                        保存角色
                      </button>
                    </div>
                    <button
                      type="button"
                      class="rounded-2xl border border-rose-500/30 px-4 py-3 text-sm font-medium text-rose-300 hover:bg-rose-500/10"
                      data-delete-user={user.id}
                    >
                      删除账号
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <script>
      const createUserForm = document.getElementById('create-user-form');
      const statusBox = document.getElementById('user-status');
      const userList = document.getElementById('user-list');

      function showStatus(type, message) {
        statusBox.className = 'mb-6 rounded-2xl border px-5 py-4 text-sm';
        statusBox.classList.remove('hidden');

        if (type === 'success') {
          statusBox.classList.add('border-emerald-500/30', 'bg-emerald-500/10', 'text-emerald-200');
        } else {
          statusBox.classList.add('border-rose-500/30', 'bg-rose-500/10', 'text-rose-200');
        }

        statusBox.textContent = message;
      }

      createUserForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = new FormData(createUserForm);

        try {
          const response = await fetch('/api/admin/users', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              action: 'create',
              displayName: form.get('displayName'),
              email: form.get('email'),
              password: form.get('password'),
              role: form.get('role'),
            }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || '创建失败');
          }

          showStatus('success', `已创建账号 ${result.user.displayName}。`);
          window.setTimeout(() => {
            window.location.reload();
          }, 700);
        } catch (error) {
          showStatus('error', error instanceof Error ? error.message : '创建失败');
        }
      });

      userList?.addEventListener('click', async (event) => {
        const deleteButton = event.target.closest('[data-delete-user]');
        if (deleteButton) {
          const userId = deleteButton.getAttribute('data-delete-user');

          try {
            const response = await fetch('/api/admin/users', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ action: 'delete', userId }),
            });

            const result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || '删除失败');
            }

            showStatus('success', `已删除账号 ${result.user.displayName}。`);
            window.setTimeout(() => {
              window.location.reload();
            }, 700);
          } catch (error) {
            showStatus('error', error instanceof Error ? error.message : '删除失败');
          }
          return;
        }

        const button = event.target.closest('[data-save-role]');
        if (!button) return;

        const userId = button.getAttribute('data-save-role');
        const select = document.querySelector(`[data-role-select="${userId}"]`);
        const role = select?.value;

        try {
          const response = await fetch('/api/admin/users', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ userId, role }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || '保存失败');
          }

          showStatus('success', `用户 ${result.user.displayName} 的角色已更新为 ${result.user.role}。`);
          window.setTimeout(() => {
            window.location.reload();
          }, 700);
        } catch (error) {
          showStatus('error', error instanceof Error ? error.message : '保存失败');
        }
      });
    </script>
  </Layout>
)}
