---
import Layout from '../../components/Layout.astro';
import { getCurrentUser, isAdmin } from '../../lib/auth.js';
import { CREATOR_STYLE_PRESETS } from '../../lib/creator-styles.js';
import { getCreatorBySlug, getCreatorPath, getCreatorSlugForUser, getCreators, slugifyCreatorName } from '../../lib/creator-universe.js';
import { getTranslations } from '../../lib/i18n.js';

const currentUser = await getCurrentUser(Astro.request);
const t = getTranslations(Astro.request);
const viewerSlug = currentUser
  ? (await getCreatorSlugForUser(currentUser)) || slugifyCreatorName(currentUser.displayName || currentUser.email || '')
  : null;
const creator = await getCreatorBySlug(Astro.params.slug, { includeUnpublished: Astro.params.slug === viewerSlug });
const isOwner = Boolean(creator && viewerSlug && creator.slug === viewerSlug);
const isAdminViewer = Boolean(currentUser && isAdmin(currentUser));
const stylePresets = Object.values(CREATOR_STYLE_PRESETS);

if (!creator) {
  Astro.response.status = 404;
}

const allCreators = await getCreators();
const relatedCreators = creator
  ? allCreators.filter((candidate) => candidate.slug !== creator.slug).slice(0, 3)
  : [];
const siteOrigin = new URL(Astro.request.url).origin;

function formatWorkStatus(status) {
  if (status === 'Live') return t.creatorSourceLive;
  if (status === 'Concept') return t.creatorConcept;
  if (status === 'Lab') return t.creatorSourceLab;
  if (status === 'Unlisted') return t.creatorUnlisted;
  return status;
}

function buildWorkShareText(work) {
  return [work?.name, work?.description, work?.detailUrl || work?.launchUrl || `${siteOrigin}/apps/${work?.slug}`]
    .filter((value) => typeof value === 'string' && value.trim())
    .join('\n');
}
---

{creator ? (
  <Layout title={creator.name} description={creator.bio}>
    <section class="min-h-screen bg-[#050816] text-white">
      <div class="relative overflow-hidden border-b border-white/10 bg-[radial-gradient(circle_at_top,rgba(16,24,48,0.96),rgba(5,8,22,0.98))]">
        <div class="absolute inset-0 opacity-70 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.16)_0,transparent_16%),radial-gradient(circle_at_80%_18%,rgba(255,255,255,0.12)_0,transparent_12%),radial-gradient(circle_at_60%_70%,rgba(255,255,255,0.12)_0,transparent_12%)]"></div>
        <div class="container mx-auto px-4 py-14 lg:py-20 relative z-10">
          <a href="/" class="inline-flex items-center text-slate-300 hover:text-white transition-colors">
            <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            {t.creatorBackHome}
          </a>

          <div class="mt-10 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
            <div class="relative mx-auto flex h-72 w-72 items-center justify-center">
              <div class="absolute inset-0 rounded-full border border-white/10"></div>
              <div class="absolute inset-[12%] rounded-full border border-white/10"></div>
              <div class={`absolute inset-[22%] rounded-full bg-gradient-to-br ${creator.accent} shadow-[0_0_90px_rgba(59,130,246,0.25)]`}></div>
              <div class="absolute inset-[30%] rounded-full bg-[radial-gradient(circle_at_30%_30%,rgba(255,255,255,0.7),rgba(255,255,255,0.08)_34%,transparent_62%)]"></div>
              <div class="relative z-10 text-center">
                <div class="text-xs uppercase tracking-[0.34em] text-white/70">{t.creatorPlanet}</div>
                <div class="mt-3 text-5xl font-semibold">{creator.initials}</div>
              </div>
            </div>

            <div>
              <p class="text-sm uppercase tracking-[0.3em] text-cyan-200">{t.creatorProfile}</p>
              <h1 class="mt-4 text-5xl font-semibold">{creator.name}</h1>
              <p class="mt-4 max-w-2xl text-lg text-slate-300">{creator.headline}</p>
              <p class="mt-6 max-w-2xl text-base leading-8 text-slate-300">{creator.bio}</p>

              <div class="mt-8 grid gap-4 sm:grid-cols-3">
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 backdrop-blur">
                  <div class="text-3xl font-semibold">{creator.totalStars}</div>
                  <div class="mt-2 text-xs uppercase tracking-[0.24em] text-slate-400">{t.creatorTotalStars}</div>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 backdrop-blur">
                  <div class="text-3xl font-semibold">{creator.works.length}</div>
                  <div class="mt-2 text-xs uppercase tracking-[0.24em] text-slate-400">{t.creatorWorks}</div>
                </div>
                <div class="rounded-3xl border border-white/10 bg-white/5 p-5 backdrop-blur">
                  <div class="text-3xl font-semibold">{creator.source === 'imported' ? t.creatorSourceLive : t.creatorSourceLab}</div>
                  <div class="mt-2 text-xs uppercase tracking-[0.24em] text-slate-400">{t.creatorSource}</div>
                </div>
              </div>

              {creator.profileUrl && (
                <a
                  href={creator.profileUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="mt-8 inline-flex items-center rounded-2xl border border-white/10 bg-white/5 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-white/10"
                >
                  {t.creatorExternal}
                </a>
              )}

              {isOwner && (
                <div class="mt-8 rounded-3xl border border-cyan-400/20 bg-cyan-400/10 p-5">
                  <p class="text-sm font-semibold text-cyan-200">{t.creatorStyleTitle}</p>
                  <p class="mt-2 text-sm text-slate-300">{t.creatorStyleDesc}</p>
                  <div class="mt-4 flex flex-wrap gap-3" id="creator-style-options">
                    {stylePresets.map((preset) => (
                      <button
                        type="button"
                        class={`rounded-2xl border px-4 py-3 text-sm font-semibold transition-colors ${creator.stylePreset === preset.id ? 'border-cyan-300 bg-white/10 text-white' : 'border-white/10 bg-white/5 text-slate-300 hover:bg-white/10'}`}
                        data-style-preset={preset.id}
                      >
                        {preset.name}
                      </button>
                    ))}
                  </div>
                  <p id="creator-style-status" class="mt-3 text-sm text-cyan-100"></p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      <div class="container mx-auto px-4 py-16">
        <section>
          <div class="mb-8 flex items-end justify-between gap-4">
            <div>
              <p class="text-sm uppercase tracking-[0.28em] text-slate-400">{t.creatorWorksList}</p>
              <h2 class="mt-3 text-3xl font-semibold">{t.creatorWorksPage}</h2>
            </div>
            <div class="text-sm text-slate-400">{t.creatorSortedByStars}</div>
          </div>

          {creator.works.length === 0 ? (
            <div class="rounded-[2rem] border border-dashed border-white/15 bg-white/[0.03] p-10 text-center">
              <p class="text-sm uppercase tracking-[0.28em] text-slate-400">{t.creatorWorksList}</p>
              <h3 class="mt-4 text-2xl font-semibold text-white">这个作者主页已经建立</h3>
              <p class="mx-auto mt-4 max-w-2xl text-sm leading-7 text-slate-300">这位用户还没有发布任何应用，所以作品区暂时为空。等他上传第一款作品后，这里就会自动出现应用卡片。</p>
            </div>
          ) : (
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3" id="creator-work-grid">
            {creator.works.map((work) => (
              <article
                class="overflow-hidden rounded-[2rem] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.88),rgba(6,10,24,0.96))]"
                data-work-card
                data-work-slug={work.slug}
              >
                <div class={`relative h-40 bg-gradient-to-br ${creator.accent}`}>
                  {(work.thumbnailDisplayUrl || work.thumbnailUrl) && (
                    <>
                      <img
                        src={work.thumbnailDisplayUrl || work.thumbnailUrl}
                        alt={work.name}
                        class="absolute inset-0 h-full w-full object-cover"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/35 to-transparent"></div>
                    </>
                  )}
                  <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(255,255,255,0.26)_0,transparent_18%),radial-gradient(circle_at_70%_70%,rgba(255,255,255,0.14)_0,transparent_22%)]"></div>
                  <div class="absolute left-5 top-5 rounded-full border border-white/20 bg-slate-950/35 px-3 py-1 text-xs uppercase tracking-[0.2em] text-white">
                    {formatWorkStatus(work.status)}
                  </div>
                  <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between gap-3">
                    <h3 class="text-2xl font-semibold text-white">{work.name}</h3>
                    <div class="rounded-full border border-white/20 bg-slate-950/35 px-3 py-1 text-sm text-amber-200" data-work-star-badge>
                      ★ {work.stars || 0}
                    </div>
                  </div>
                </div>

                <div class="p-6">
                  <p class="text-sm leading-7 text-slate-300">{work.description}</p>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {(work.tags || []).map((tag) => (
                      <span class="rounded-full bg-white/8 px-3 py-1 text-xs font-medium text-slate-200">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="mt-6 flex gap-3">
                    {work.detailUrl ? (
                      <a
                        href={work.detailUrl}
                        class="inline-flex flex-1 items-center justify-center rounded-xl bg-white text-slate-950 px-4 py-3 text-sm font-semibold transition-colors hover:bg-slate-200"
                      >
                        {t.creatorViewWork}
                      </a>
                    ) : (
                      <span class="inline-flex flex-1 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-300">
                        {t.creatorComingSoon}
                      </span>
                    )}

                    {work.launchUrl ? (
                      <a
                        href={work.launchUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex flex-1 items-center justify-center rounded-xl bg-gradient-to-r from-cyan-400 to-blue-600 px-4 py-3 text-sm font-semibold text-slate-950"
                      >
                        {t.creatorLaunch}
                      </a>
                    ) : (
                      <span class="inline-flex flex-1 items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-300">
                        {t.creatorConcept}
                      </span>
                    )}
                  </div>

                  {(isOwner || isAdminViewer) && work.type === 'app' && (
                    <div class="mt-4 space-y-3">
                      {isOwner && (
                        <div class="grid grid-cols-2 gap-3">
                          <button
                            type="button"
                            class="inline-flex items-center justify-center rounded-xl border border-cyan-400/30 bg-cyan-400/10 px-4 py-3 text-sm font-semibold text-cyan-100 transition-colors hover:bg-cyan-400/15"
                            data-upload-cover-trigger={work.slug}
                          >
                            {t.creatorUploadCover}
                          </button>
                          <button
                            type="button"
                            class={`inline-flex items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold transition-colors ${work.status === 'Unlisted' ? 'bg-emerald-400 text-slate-950 hover:bg-emerald-300' : 'border border-amber-400/30 bg-amber-400/10 text-amber-200 hover:bg-amber-400/15'}`}
                            data-toggle-work-publish={work.slug}
                            data-next-published={work.status === 'Unlisted' ? 'true' : 'false'}
                          >
                            {work.status === 'Unlisted' ? t.creatorPublish : t.creatorUnpublish}
                          </button>
                          <button
                            type="button"
                            class="inline-flex items-center justify-center rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm font-semibold text-rose-200 transition-colors hover:bg-rose-400/15"
                            data-delete-work={work.slug}
                          >
                            {t.creatorDelete}
                          </button>
                          <button
                            type="button"
                            class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-100 transition-colors hover:bg-white/10"
                            data-share-work-button
                            data-share-text={buildWorkShareText(work)}
                          >
                            {t.creatorShare}
                          </button>
                        </div>
                      )}
                      {isAdminViewer && (
                        <div class="rounded-2xl border border-fuchsia-400/20 bg-fuchsia-400/8 p-4">
                          <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                            <label class="flex-1">
                              <span class="mb-2 block text-xs font-semibold uppercase tracking-[0.22em] text-fuchsia-100">{t.creatorAdminStarLabel}</span>
                              <input
                                type="number"
                                min="0"
                                step="1"
                                value={work.stars || 0}
                                class="w-full rounded-xl border border-white/10 bg-slate-950/50 px-4 py-3 text-sm text-white outline-none transition-colors focus:border-fuchsia-300"
                                data-admin-star-input={work.slug}
                              />
                            </label>
                            <button
                              type="button"
                              class="inline-flex items-center justify-center rounded-xl border border-fuchsia-300/30 bg-fuchsia-300/10 px-4 py-3 text-sm font-semibold text-fuchsia-100 transition-colors hover:bg-fuchsia-300/15"
                              data-admin-star-save={work.slug}
                            >
                              {t.creatorAdminStarSave}
                            </button>
                          </div>
                          <div class="mt-3 grid grid-cols-2 gap-3">
                            <button
                              type="button"
                              class="inline-flex items-center justify-center rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm font-semibold text-rose-200 transition-colors hover:bg-rose-400/15"
                              data-delete-work={work.slug}
                            >
                              {t.creatorDelete}
                            </button>
                            <button
                              type="button"
                              class="inline-flex items-center justify-center rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-slate-100 transition-colors hover:bg-white/10"
                              data-share-work-button
                              data-share-text={buildWorkShareText(work)}
                            >
                              {t.creatorShare}
                            </button>
                          </div>
                          <p class="mt-2 text-xs text-slate-400">{t.creatorAdminStarHint}</p>
                        </div>
                      )}
                      <input
                        type="file"
                        accept="image/png,image/jpeg,.png,.jpg,.jpeg"
                        class="hidden"
                        data-upload-cover-input={work.slug}
                      />
                      {isOwner && (
                        <>
                          <p class="text-xs text-slate-400" data-work-status>
                            {work.status === 'Unlisted' ? t.creatorHidden : t.creatorVisible}
                          </p>
                          <p class="text-[11px] text-slate-500">{t.creatorCoverHint}</p>
                        </>
                      )}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
          )}
        </section>

        {relatedCreators.length > 0 && (
          <section class="mt-20">
            <p class="text-sm uppercase tracking-[0.28em] text-slate-400">{t.creatorMore}</p>
            <h2 class="mt-3 text-3xl font-semibold">{t.creatorExplore}</h2>
            <div class="mt-8 grid gap-5 md:grid-cols-3">
              {relatedCreators.map((item) => (
                <a
                  href={getCreatorPath(item.slug)}
                  class="rounded-[1.75rem] border border-white/10 bg-white/5 p-6 transition-colors hover:bg-white/8"
                >
                  <div class={`h-24 rounded-[1.25rem] bg-gradient-to-br ${item.accent}`}></div>
                  <h3 class="mt-5 text-xl font-semibold text-white">{item.name}</h3>
                  <p class="mt-2 text-sm text-slate-300">{item.headline}</p>
                  <p class="mt-4 text-xs uppercase tracking-[0.24em] text-slate-400">{item.totalStars} {t.creatorStarSuffix}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </section>

    {(isOwner || isAdminViewer) && (
      <script define:vars={{
        slug: creator.slug,
        creatorSavingStyle: t.creatorSavingStyle,
        creatorSaveFailed: t.creatorSaveFailed,
        creatorStyleUpdated: t.creatorStyleUpdated,
        creatorUpdateFailed: t.creatorUpdateFailed,
        creatorDeleteFailed: t.creatorDeleteFailed,
        creatorPublishing: t.creatorPublishing,
        creatorUnpublishing: t.creatorUnpublishing,
        creatorPublishedDone: t.creatorPublishedDone,
        creatorUnpublishedDone: t.creatorUnpublishedDone,
        creatorDeleteLabel: t.creatorDeleteLabel,
        creatorDeleteConfirm: t.creatorDeleteConfirm,
        creatorDeleteWarn: t.creatorDeleteWarn,
        creatorDeleteCanceled: t.creatorDeleteCanceled,
        creatorDeleted: t.creatorDeleted,
        creatorUploadCover: t.creatorUploadCover,
        creatorUploadingCover: t.creatorUploadingCover,
        creatorCoverUpdated: t.creatorCoverUpdated,
        creatorCoverFailed: t.creatorCoverFailed,
        creatorAdminStarSaving: t.creatorAdminStarSaving,
        creatorAdminStarSaved: t.creatorAdminStarSaved,
        creatorAdminStarFailed: t.creatorAdminStarFailed,
      }}>
        const styleOptions = document.getElementById('creator-style-options');
        const styleStatus = document.getElementById('creator-style-status');
        const workGrid = document.getElementById('creator-work-grid');

        function setManageStatus(message, isError = false) {
          if (!styleStatus) return;
          styleStatus.textContent = message;
          styleStatus.classList.toggle('text-rose-200', isError);
          styleStatus.classList.toggle('text-cyan-100', !isError);
        }

        styleOptions?.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-style-preset]');
          if (!button) return;

          const preset = button.getAttribute('data-style-preset');
          setManageStatus(creatorSavingStyle);

          try {
            const response = await fetch('/api/creators/style', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({ slug, preset }),
            });

            const result = await response.json();
            if (!response.ok || !result.success) {
              throw new Error(result.error || creatorSaveFailed);
            }

            setManageStatus(creatorStyleUpdated);
            window.setTimeout(() => window.location.reload(), 500);
          } catch (error) {
            setManageStatus(error instanceof Error ? error.message : creatorSaveFailed, true);
          }
        });

        async function toggleWorkPublication(slug, published) {
          const response = await fetch('/api/update-app', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ slug, published }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || creatorUpdateFailed);
          }
        }

        async function deleteWork(slug) {
          const response = await fetch('/api/delete-app', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ slug }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || creatorDeleteFailed);
          }

          return true;
        }

        async function uploadWorkCover(slug, file) {
          const formData = new FormData();
          formData.append('slug', slug);
          formData.append('cover', file);

          const response = await fetch('/api/upload-app-cover', {
            method: 'POST',
            body: formData,
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || creatorCoverFailed);
          }
        }

        async function saveAdminStarCount(slug, count) {
          const response = await fetch('/api/update-app', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ slug, action: 'set-star-count', count }),
          });

          const result = await response.json();
          if (!response.ok || !result.success) {
            throw new Error(result.error || creatorAdminStarFailed);
          }

          return result;
        }

        workGrid?.addEventListener('click', async (event) => {
          const publishButton = event.target.closest('[data-toggle-work-publish]');
          const deleteButton = event.target.closest('[data-delete-work]');
          const uploadButton = event.target.closest('[data-upload-cover-trigger]');
          const saveStarButton = event.target.closest('[data-admin-star-save]');

          if (uploadButton) {
            const workSlug = uploadButton.getAttribute('data-upload-cover-trigger');
            const input = workGrid.querySelector(`[data-upload-cover-input="${workSlug}"]`);
            input?.click();
            return;
          }

          if (saveStarButton) {
            try {
              const workSlug = saveStarButton.getAttribute('data-admin-star-save');
              const input = workGrid.querySelector(`[data-admin-star-input="${workSlug}"]`);
              const nextCount = input?.value ?? '';
              setManageStatus(creatorAdminStarSaving);
              const result = await saveAdminStarCount(workSlug, nextCount);
              if (input) {
                input.value = String(result.count ?? nextCount);
              }
              const card = workGrid.querySelector(`[data-work-card][data-work-slug="${workSlug}"]`);
              const badge = card?.querySelector('[data-work-star-badge]');
              if (badge) {
                badge.textContent = `★ ${result.count ?? nextCount}`;
              }
              setManageStatus(creatorAdminStarSaved);
            } catch (error) {
              setManageStatus(error instanceof Error ? error.message : creatorAdminStarFailed, true);
            }
            return;
          }

          if (publishButton) {
            try {
              const workSlug = publishButton.getAttribute('data-toggle-work-publish');
              const nextPublished = publishButton.getAttribute('data-next-published') === 'true';
              setManageStatus(nextPublished ? creatorPublishing : creatorUnpublishing);
              await toggleWorkPublication(workSlug, nextPublished);
              setManageStatus(nextPublished ? creatorPublishedDone : creatorUnpublishedDone);
              window.setTimeout(() => window.location.reload(), 500);
            } catch (error) {
              setManageStatus(error instanceof Error ? error.message : creatorUpdateFailed, true);
            }
            return;
          }

          if (!deleteButton) return;

          try {
            const pendingDeleteSlug = deleteButton.getAttribute('data-pending-delete');
            const workSlug = deleteButton.getAttribute('data-delete-work');

            if (pendingDeleteSlug !== workSlug) {
              workGrid
                .querySelectorAll('[data-delete-work][data-pending-delete]')
                .forEach((button) => {
                  button.removeAttribute('data-pending-delete');
                  button.textContent = creatorDeleteLabel;
                });

              deleteButton.setAttribute('data-pending-delete', workSlug);
              deleteButton.textContent = creatorDeleteConfirm;
              setManageStatus(creatorDeleteWarn, true);

              window.setTimeout(() => {
                if (deleteButton.getAttribute('data-pending-delete') === workSlug) {
                  deleteButton.removeAttribute('data-pending-delete');
                  deleteButton.textContent = creatorDeleteLabel;
                  setManageStatus(creatorDeleteCanceled);
                }
              }, 5000);
              return;
            }

            const deleted = await deleteWork(deleteButton.getAttribute('data-delete-work'));
            if (!deleted) return;
            setManageStatus(creatorDeleted);
            window.setTimeout(() => window.location.href = '/creators/me', 500);
          } catch (error) {
            setManageStatus(error instanceof Error ? error.message : creatorDeleteFailed, true);
          }
        });

        workGrid?.addEventListener('change', async (event) => {
          const input = event.target.closest('[data-upload-cover-input]');
          if (!input?.files?.length) return;

          const workSlug = input.getAttribute('data-upload-cover-input');
          const file = input.files[0];

          try {
            setManageStatus(creatorUploadingCover);
            await uploadWorkCover(workSlug, file);
            setManageStatus(creatorCoverUpdated);
            window.setTimeout(() => window.location.reload(), 500);
          } catch (error) {
            setManageStatus(error instanceof Error ? error.message : creatorCoverFailed, true);
          } finally {
            input.value = '';
          }
        });

      </script>
    )}
    <script define:vars={{ shareCopied: t.shareCopied, shareFailed: t.shareFailed }}>
      const creatorWorkGrid = document.getElementById('creator-work-grid');

      async function shareCreatorWork(shareText) {
        if (!shareText) {
          window.alert(shareFailed);
          return;
        }

        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(shareText);
            window.alert(shareCopied);
            return;
          }

          throw new Error(shareFailed);
        } catch (error) {
          if (error?.name === 'AbortError') return;
          window.alert(shareFailed);
        }
      }

      creatorWorkGrid?.querySelectorAll('[data-share-work-button]').forEach((button) => {
        button.addEventListener('click', async () => {
          await shareCreatorWork(button.getAttribute('data-share-text') || '');
        });
      });
    </script>
  </Layout>
) : (
  <Layout title={t.creatorNotFoundTitle} description={t.creatorNotFoundDesc}>
    <section class="min-h-screen bg-[#050816] text-white grid place-items-center">
      <div class="text-center">
        <h1 class="text-4xl font-bold mb-4">{t.creatorNotFoundTitle}</h1>
        <p class="text-slate-400 mb-6">{t.creatorNotFoundDesc}</p>
        <a href="/" class="inline-flex items-center justify-center rounded-xl bg-cyan-500 px-6 py-3 font-semibold text-slate-950 hover:bg-cyan-400">
          {t.backToHome}
        </a>
      </div>
    </section>
  </Layout>
)}
