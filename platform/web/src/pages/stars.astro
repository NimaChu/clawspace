---
import Layout from '../components/Layout.astro';
import { getCurrentUser } from '../lib/auth.js';
import { getPublishedApps } from '../lib/app-registry.js';
import { getUserStarredSlugs } from '../lib/app-stars.js';
import { getTranslations } from '../lib/i18n.js';

const currentUser = await getCurrentUser(Astro.request);
if (!currentUser) {
  return Astro.redirect('/login?next=%2Fstars');
}

const t = getTranslations(Astro.request);
const starredSlugs = await getUserStarredSlugs(currentUser.id);
const publishedApps = await getPublishedApps();
const apps = publishedApps.filter((app) => starredSlugs.includes(app.slug));
---

<Layout title={t.favoritesTitle} description={t.favoritesDescription}>
  <section class="min-h-screen bg-[#050816] py-16 lg:py-24 text-white">
    <div class="container mx-auto max-w-6xl px-4">
      <div class="mb-10">
        <a href="/" class="inline-flex items-center text-slate-300 hover:text-white transition-colors">
          <svg class="mr-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
          {t.backToHome}
        </a>
        <p class="mt-6 text-sm uppercase tracking-[0.28em] text-amber-200">{t.navFavorites}</p>
        <h1 class="mt-3 text-4xl font-semibold">{t.favoritesHeading}</h1>
        <p class="mt-4 max-w-2xl text-base leading-8 text-slate-300">{t.favoritesIntro}</p>
      </div>

      {apps.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {apps.map((app) => (
            <article class="overflow-hidden rounded-[1.8rem] border border-white/10 bg-[linear-gradient(180deg,rgba(15,23,42,0.88),rgba(6,10,24,0.96))]">
              <div class="relative h-44 overflow-hidden bg-[radial-gradient(circle_at_top,rgba(34,211,238,0.24),rgba(15,23,42,0.9))]">
                {app.thumbnailDisplayUrl || app.thumbnailUrl ? (
                  <img
                    src={app.thumbnailDisplayUrl || app.thumbnailUrl}
                    alt={app.name}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-cyan-500/30 via-sky-500/10 to-slate-950"></div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 to-transparent"></div>
                <div class="absolute left-4 top-4 rounded-full border border-white/10 bg-slate-950/50 px-3 py-1 text-xs font-medium text-amber-200">
                  ★ {app.stars || 0}
                </div>
                <div class="absolute bottom-4 left-4 right-4">
                  <h2 class="text-2xl font-semibold text-white">{app.name}</h2>
                </div>
              </div>

              <div class="p-5">
                <p class="line-clamp-2 text-sm leading-7 text-slate-300">{app.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {(app.tags || []).slice(0, 4).map((tag) => (
                    <span class="rounded-full bg-white/8 px-3 py-1 text-xs font-medium text-slate-200">
                      {tag}
                    </span>
                  ))}
                </div>
                <div class="mt-5 flex gap-3">
                  <a
                    href={`/apps/${app.slug}`}
                    class="inline-flex flex-1 items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-slate-200"
                  >
                    {t.atlasLearnMore}
                  </a>
                  <a
                    href={app.launchUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex flex-1 items-center justify-center rounded-xl bg-gradient-to-r from-cyan-400 to-blue-600 px-4 py-3 text-sm font-semibold text-slate-950"
                  >
                    {t.atlasTryNow}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="rounded-[2rem] border border-dashed border-white/10 bg-white/5 px-8 py-14 text-center">
          <h2 class="text-2xl font-semibold text-white">{t.favoritesEmptyTitle}</h2>
          <p class="mt-3 text-slate-300">{t.favoritesEmptyDesc}</p>
          <a
            href="/#apps"
            class="mt-6 inline-flex items-center justify-center rounded-xl bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition-colors hover:bg-slate-200"
          >
            {t.favoritesBrowse}
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>
