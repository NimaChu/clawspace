<view class="page-shell detail-shell">
  <view wx:if="{{error}}" class="glass-card placeholder-card">
    {{error}}
  </view>

  <block wx:elif="{{app}}">
    <view class="detail-hero glass-card">
      <image wx:if="{{app.thumbnailUrl}}" class="detail-cover" src="{{app.thumbnailUrl}}" mode="aspectFill" lazy-load="true" binderror="handleCoverError"></image>
      <view wx:else class="detail-cover detail-cover-fallback">NO COVER</view>
      <view class="detail-cover-overlay"></view>
      <view class="detail-topline">
        <view class="signal-chip">{{app.wechatSupport}}</view>
        <view class="detail-share-hint">星标 {{app.starCount}}</view>
      </view>
      <view class="detail-hero-copy">
        <view class="detail-name">{{app.name}}</view>
        <view class="detail-author muted">{{app.authorName}}</view>
      </view>
    </view>

    <view class="glass-card detail-body">
      <view class="detail-section">
        <view class="section-kicker">MISSION BRIEF</view>
        <view class="detail-description muted">{{app.description}}</view>
      </view>

      <view wx:if="{{app.tags.length}}" class="detail-section">
        <view class="section-kicker">SIGNALS</view>
        <view class="tag-row">
          <view wx:for="{{app.tags}}" wx:key="*this" class="pill tag-pill">{{item}}</view>
        </view>
      </view>

      <view class="detail-stats">
        <view class="detail-stat">
          <view class="detail-stat-value">{{app.starCount}}</view>
          <view class="detail-stat-label">星标热度</view>
        </view>
        <view class="detail-stat">
          <view class="detail-stat-value">{{app.wechatSupport}}</view>
          <view class="detail-stat-label">微信兼容</view>
        </view>
      </view>

      <view wx:if="{{app.wechatNotes}}" class="detail-notes">
        <view class="section-kicker">WECHAT NOTES</view>
        <view class="muted">{{app.wechatNotes}}</view>
      </view>

      <view class="detail-actions">
        <view class="primary-button detail-button" bindtap="openRuntime">复制链接去浏览器体验</view>
        <view class="secondary-button detail-button" bindtap="toggleStar">
          {{starBusy ? '处理中...' : (isStarred ? '取消收藏' : '收藏应用')}}
        </view>
        <button class="detail-ghost-button" open-type="share">分享给好友</button>
      </view>
      <view class="detail-browser-note muted">当前个人主体小程序无法直接内嵌运行网页应用，已改为复制链接后在浏览器打开。</view>
    </view>
  </block>

  <view wx:else class="glass-card placeholder-card">
    正在加载应用详情...
  </view>
</view>
