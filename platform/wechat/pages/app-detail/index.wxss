.detail-shell {
  padding-top: 12rpx;
}

.detail-hero {
  overflow: hidden;
}

.detail-cover {
  width: 100%;
  height: 390rpx;
  display: block;
  background: #132038;
}

.detail-cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9bafd9;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.detail-cover-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5, 10, 20, 0.1) 0%, rgba(5, 10, 20, 0.24) 35%, rgba(5, 10, 20, 0.88) 100%);
}

.detail-topline {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-share-hint {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(5, 8, 22, 0.56);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #ffdcb7;
  font-size: 21rpx;
}

.detail-hero-copy {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 2;
}

.detail-name {
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #f9fbff;
}

.detail-author {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.detail-body {
  margin-top: 20rpx;
  padding: 28rpx 26rpx;
}

.detail-section + .detail-section {
  margin-top: 22rpx;
}

.detail-description {
  font-size: 25rpx;
  line-height: 1.72;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-stats {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.detail-stat {
  padding: 18rpx 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.detail-stat-value {
  font-size: 32rpx;
  font-weight: 900;
  color: #f8fbff;
}

.detail-stat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9eb0d7;
}

.detail-notes {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 23rpx;
  line-height: 1.68;
}

.detail-actions {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-browser-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

.detail-button,
.detail-ghost-button {
  width: 100%;
}

.detail-ghost-button {
  min-height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  color: #f6f8ff;
  line-height: 84rpx;
}
