.atlas-shell {
  padding-top: 12rpx;
}

.atlas-hero {
  padding: 28rpx 26rpx 26rpx;
}

.atlas-glow {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(40rpx);
}

.atlas-glow-blue {
  top: -28rpx;
  right: -22rpx;
  width: 180rpx;
  height: 180rpx;
  background: rgba(78, 162, 255, 0.2);
}

.atlas-glow-orange {
  left: -24rpx;
  bottom: -20rpx;
  width: 210rpx;
  height: 140rpx;
  background: rgba(255, 117, 79, 0.18);
}

.atlas-title {
  position: relative;
  z-index: 1;
}

.atlas-copy {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.68;
}

.tag-scroll {
  margin-top: 18rpx;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.tag-pill {
  flex-shrink: 0;
}

.tag-active {
  background: linear-gradient(135deg, #ff6f4f 0%, #ff8e58 100%);
  border-color: transparent;
  color: #fff8f4;
}

.atlas-error {
  margin-bottom: 20rpx;
}

.atlas-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.atlas-card {
  overflow: hidden;
}

.atlas-visual-shell {
  position: relative;
}

.atlas-thumb {
  width: 100%;
  height: 286rpx;
  display: block;
  background: #131f37;
}

.atlas-thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9bafd9;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.atlas-thumb-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(5, 10, 20, 0.06) 0%, rgba(5, 10, 20, 0.18) 46%, rgba(5, 10, 20, 0.78) 100%);
}

.atlas-thumb-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.04) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1rpx, transparent 1rpx);
  background-size: 30rpx 30rpx;
  opacity: 0.3;
}

.atlas-thumb-top {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  right: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  z-index: 2;
}

.atlas-star-chip {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(5, 8, 22, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #ffe4a8;
  font-size: 22rpx;
}

.atlas-meta {
  padding: 24rpx 24rpx 26rpx;
}

.atlas-name {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #f8fbff;
}

.atlas-author {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.atlas-description {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.62;
}

.atlas-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.atlas-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.07);
  color: #edf2ff;
  font-size: 20rpx;
}

.atlas-footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  font-size: 21rpx;
}

.atlas-open {
  color: #ffcfbf;
  font-weight: 800;
}

.load-more {
  margin-top: 24rpx;
  width: 100%;
}
