.creator-detail-page {
  padding-top: 12rpx;
}

.creator-detail-hero {
  padding: 28rpx 26rpx;
  margin-bottom: 24rpx;
}

.creator-detail-name {
  margin-top: 8rpx;
  font-size: 44rpx;
  line-height: 1.12;
  font-weight: 900;
  color: #f8fbff;
}

.creator-detail-headline {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.creator-detail-stats {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
}

.creator-detail-stat {
  flex: 1;
  min-width: 0;
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  background: rgba(12, 18, 34, 0.74);
  padding: 18rpx 18rpx 16rpx;
}

.creator-detail-stat-value {
  font-size: 34rpx;
  font-weight: 900;
  color: #f8fbff;
}

.creator-detail-stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #91a0c5;
}

.creator-detail-bio {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.72;
}

.creator-detail-section {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.creator-works-title {
  margin-top: 6rpx;
}

.creator-work-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.creator-work-card {
  overflow: hidden;
}

.creator-work-cover {
  width: 100%;
  height: 280rpx;
  display: block;
  background: linear-gradient(135deg, rgba(255, 112, 74, 0.22) 0%, rgba(55, 89, 164, 0.3) 100%);
}

.creator-work-copy {
  padding: 22rpx;
}

.creator-work-topline {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  justify-content: space-between;
}

.creator-work-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: #f8fbff;
}

.creator-work-stars {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffb07b;
}

.creator-work-description {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
}

.creator-work-tags {
  margin-top: 16rpx;
  flex-wrap: wrap;
}
