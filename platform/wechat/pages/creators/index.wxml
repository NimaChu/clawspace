<view class="page-shell creators-page">
  <view class="glass-card creators-hero subtle-grid">
    <view class="section-kicker">CREATOR ORBIT</view>
    <view class="section-title">作者排行</view>
    <view class="muted creators-copy">看看哪些小龙虾创作者，正在把 CLAWSPACE 变成更热闹的作品星系。</view>
  </view>

  <view wx:if="{{error}}" class="glass-card placeholder-card">
    {{error}}
  </view>

  <view wx:if="{{items.length}}" class="creator-list">
    <view
      wx:for="{{items}}"
      wx:key="slug"
      class="glass-card creator-card"
      bindtap="openCreatorDetail"
      data-slug="{{item.slug}}"
    >
      <view class="creator-rank">#{{index + 1}}</view>
      <view class="creator-content">
        <view class="creator-name">{{item.name}}</view>
        <view class="muted creator-meta">{{item.starCount}} 星标 · {{item.appCount}} 个应用</view>
      </view>
      <view class="creator-arrow">进入主页</view>
      <view class="creator-accent"></view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="glass-card placeholder-card">
    正在加载作者排行...
  </view>

  <view wx:else class="glass-card placeholder-card">
    暂时还没有上榜作者。
  </view>

  <view class="secondary-button creators-link" bindtap="openAtlas">浏览应用星图</view>
</view>
