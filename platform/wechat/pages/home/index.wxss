.home-shell {
  padding-top: 10rpx;
}

.hero-poster {
  padding: 34rpx 28rpx 30rpx;
}

.poster-halo {
  position: absolute;
  border-radius: 999rpx;
  filter: blur(44rpx);
  opacity: 0.9;
}

.poster-halo-blue {
  top: -30rpx;
  right: -10rpx;
  width: 220rpx;
  height: 220rpx;
  background: rgba(81, 168, 255, 0.24);
}

.poster-halo-orange {
  left: -20rpx;
  bottom: -24rpx;
  width: 240rpx;
  height: 180rpx;
  background: rgba(255, 117, 79, 0.22);
}

.poster-topline,
.poster-copy,
.poster-stats,
.poster-actions {
  position: relative;
  z-index: 1;
}

.poster-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.poster-brand {
  font-size: 68rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 3rpx;
  text-shadow:
    0 12rpx 34rpx rgba(255, 111, 79, 0.2),
    0 4rpx 18rpx rgba(90, 160, 255, 0.14);
}

.poster-brand-claw {
  color: #ff6f4f;
}

.poster-brand-space {
  color: #fff4ee;
}

.poster-badge {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #ffbaa3;
}

.poster-chip {
  margin-top: 6rpx;
}

.poster-copy {
  margin-top: 24rpx;
}

.poster-title {
  max-width: 560rpx;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #f7faff;
}

.poster-desc {
  margin-top: 18rpx;
  max-width: 590rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: #edf2ff;
}

.poster-stats {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.poster-stat {
  padding: 18rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.poster-stat-value {
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
}

.poster-stat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9fb0d6;
}

.poster-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.poster-action-main,
.poster-action-secondary {
  min-width: 250rpx;
}

.install-panel {
  padding: 28rpx 26rpx;
}

.install-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
  color: #fff2ec;
}

.install-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
}

.install-prompt {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(5, 10, 20, 0.66);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #dbe8ff;
  font-size: 22rpx;
  line-height: 1.68;
  word-break: break-all;
}

.install-button {
  margin-top: 18rpx;
  align-self: flex-start;
}

.error-card {
  margin-top: 30rpx;
}

.creator-orbit-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.creator-orbit-card {
  padding: 22rpx 22rpx 24rpx;
}

.creator-orbit-rank {
  font-size: 18rpx;
  letter-spacing: 2.6rpx;
  color: #ffbaa3;
}

.creator-orbit-main {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.creator-orbit-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff7a58 0%, #ffb06b 100%);
  color: #22110a;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 34rpx rgba(255, 122, 88, 0.22);
}

.creator-orbit-meta {
  flex: 1;
  min-width: 0;
}

.creator-orbit-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #f7faff;
}

.creator-orbit-copy {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.creator-orbit-link {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffb07b;
}
