.search-page {
  padding-top: 12rpx;
}

.search-hero {
  padding: 28rpx 26rpx;
  margin-bottom: 22rpx;
}

.search-hero-copy {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.66;
}

.search-shell {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.search-input {
  flex: 1;
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: rgba(6, 12, 24, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #f6f8ff;
  font-size: 24rpx;
  box-sizing: border-box;
}

.search-action {
  min-width: 156rpx;
}

.search-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.result-card {
  padding: 22rpx 22rpx 24rpx;
}

.result-header {
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
  align-items: flex-start;
}

.result-name {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #f8fbff;
}

.result-description {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.62;
}

.result-meta {
  margin-top: 14rpx;
  font-size: 22rpx;
}

.result-pill {
  flex-shrink: 0;
}
